# Root-level environment variables for Docker Compose
# Copy this file to .env and fill in real values before running docker-compose up

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_64_char_random_hex_string_never_commit_real_value

# ── Ports (optional override) ─────────────────────────────────────────────────
# BACKEND_PORT=5000
# ML_PORT=8000
# FRONTEND_PORT=5173
