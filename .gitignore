# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/

# ── Python / ML Service ───────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
.eggs/
.venv/
venv/
*.so

# ── Environment files (NEVER commit real secrets) ─────────────────────────────
.env
.env.local
.env.production
# Keep .env.example committed as a template
!.env.example
!backend/.env.example
!ml_service/.env.example

# ── Model weights (large binary files, store externally) ──────────────────────
ml_service/weights/*.pth
ml_service/weights/*.pt
# Keep the directory and training log
!ml_service/weights/.gitkeep
ml_service/weights/training_log.json

# ── Uploaded files (user data, not source code) ───────────────────────────────
ml_service/uploads/
backend/uploads/
!ml_service/uploads/.gitkeep
!backend/uploads/.gitkeep

# ── Datasets (too large for git, store externally or use DVC) ────────────────
Datasets/

# ── OS junk ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── IDE ───────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
